ry Sorting\":\"Sorting\",\"Attachment Upload\\/Association\":\"ATT Upload\\/Association\",\"Attachment Download\\/Preview\":\"ATT Download\\/Preview\",\"Attachment Delete\\/Disassociation\":\"ATT Delete\\/Disassociation\"},\"workitem change\":{\"creator\":\"Creator\",\"author\":\"Author\",\"change type\":\"Change Type\",\"change field\":\"Change Field\",\"change before\":\"Change Before\",\"change after\":\"Change After\",\"extend from #story id#\":\"inherentance rule\",\"created\":\"Created\",\"auto task\":\"Trigger Automation\",\"manual update\":\"Manual Change\",\"sync copy\":\"Sync Linkage\",\"api\":\"API Change\",\"new value\":\"After Change\",\"smart commit\":\"Smart Commit Trigger\",\"story status relation\":\"Parent\\/Sub #Story# Linkage\",\"code change\":\"Code Change\",\"field\":\"Changed Field\",\"auto workflow\":\"Automation Workflow Trigger\",\"old value\":\"Before Change\",\"import update\":\"Import and Update\",\"link update\":\"update link\",\"link delete\":\"delete link\",\"link create\":\"create link\",\"download attachment\":\"Download\",\"time relation create\":\"create relation\",\"time relation update\":\"update relation type\",\"time relation delete\":\"delete relation\",\"Associated Project Setting\":\"Collaborative Project Setting\",\"entity type\":\"Entity type\",\"relation workspace id\":\"Relation Workspace\",\"operate type\":\"Operate Type\",\"action\":\"Operate type\",\"bind\":\"Bind\",\"unbind\":\"Unbind\",\"archive\":\"Archive\",\"unarchive\":\"Unarchive\",\"story task relation\":\"story_task_relation\",\"Inherit the access allow list from the <a href='#href#' target=' blank'>parent story<\\/a>\":\"Inherit the accessible scope from the <a href='#href#' target='_blank'>parent #story#<\\/a>\",\"create story\":\"create_story\",\"create story from bug\":\"create_story_from_bug\",\"create story from copy\":\"create_story_from_copy\",\"create story from import\":\"create_story_from_import\",\"create story from copy preset\":\"create_story_from_copy_preset\",\"create story from api\":\"create_story_from_api\",\"create story from robot\":\"create_story_from_robot\",\"create story from copy by auto task\":\"create_story_from_copy_by_auto_task\",\"create story by auto task\":\"create_story_by_auto_task\",\"Story Settings\":\"#Story# Settings\",\"summary sub story effort\":\"summary effort\",\"summary task effort\":\"summary effort\",\"Checklist Settings\":\"Checklist Settings\",\"create checklist\":\"Create Check Item\",\"delete checklist\":\"Delete Check Item\",\"[#checklist name#]\":\"[#checklist_name#]\",\"Check Item [#checklist name#]\":\"Check Item [#checklist_name#]\",\"transfer story to bug\":\"Convert Story to Bug\",\"transfer bug id\":\"Bug ID\",\"mini auto task\":\"Light Collaboration Automation Trigger\"},\"workitem field\":{\"Custom fields\":\"Custom Fields\",\"Measure Fields\":\"Effort Fields\",\"Measure fields\":\"Effort Fields\",\"Personnel and Time fields\":\"Person & Time Fields\",\"Foundation fields\":\"Basic Fields\",\"Person & Time Field\":\"Person & Time Fields\",\"Foundation Fields\":\"Basic Fields\"},\"workitem secret\":{\"The story created with this template will only can be accessed by the members in accessibility setting.\":\"#Stories# created using this template are only available to members within the accessible scope by default.\",\"This story has already had accessibility setting.\":\"This #story# has been configured with the accessible scope.\",\"Synchronized copied story cannot be set access scope.\":\"You cannot set accessible scope for the replicated #stories#.\",\"Can NOT operate story which you do NOT have visit permission\":\"You cannot operate #stories# not in the accessible scope.\",\"Only creator and workspace admin can set story accessibility.\":\"Only the #story# creator or admin can set the accessible scope for #stories#.\",\"Story with access scope cannot be copied\":\"You cannot copy #stories# with an accessible scope.\",\"Accessible state\":\"Access Status\",\"Don't have permission to operate workitem of inaccessible board\":\"You cannot operate board workitems that you have no access to.\",\"Set  who cannot visit accessible story\":\"Set user groups that do not have access to public #stories#\",\"The chosen user group cannot visit stories which didn't set  accessible scope. You can set accessible scope in story details page to control who can visit story tree.\":\"The selected user groups have no access to all the #stories# in the project by default. You can add user groups to the accessible scope for a #story# to control user access to the #story#.\",\"The story created with this template will be open to all project members.\":\"#Stories# created using this template are visible to project members by default.\",\"Inaccessible story cannot be imported and updated\":\"You cannot update #stories# that you have no access to.\",\"Story that has set visit scope cannot sync info\":\"You cannot sync information for #stories# with an accessible scope.\",\"Inaccessible story cannot be the parent story\":\"The importer cannot select the inaccessible #story# as the parent #story# to import.\",\"This workitem belongs to an inaccessible board, you cannot visit\":\"This is a private board. You have no permission to view it.\",\"Story Creator\":\"#Story# Creator\",\"Set default access scope\":\"Default Accessible Scope Settings\",\"This is an inaccessible story, you cannot visit\":\"This is a private #story#. You have no permission to view it.\",\"Access scope\":\"Accessible Scope\",\"You don't have permission to set story secrecy.\":\"You don't have permission to set #story# secrecy.\",\"After setting the accessible personnel, the selected demand and all the lower-level demands will only allow the personnel in the list to access.\":\"After setting the accessible personnel, the selected demand and all the lower-level demands will only allow the personnel in the list to access.\",\"The chosen stories and their child-stories will be set 