escription\",\"Add field\":\"Add Field\",\"Save story fields setting successfully!\":\"#Story# display fields set successfully.\",\"Bug Workflow Step List\":\"Bug Workflow Step List\",\"Status Show Field Setting\":\"Status Display Field Settings\",\"Select Status\":\"Select Status\",\"Basic Information\":\"Basic Info\",\"Create workflow with template\":\"Created from Template\",\"Create workflow directly\":\"Create Directly\",\"Story Workflow\":\"#Story# Workflow Configuration\",\"Add Workflow\":\"Add Workflow\",\"Save workflow successfully!\":\"Workflow saved successfully.\",\"Status Fields Setting\":\"Display Field Settings\",\"Edit Status\":\"Edit Status\",\"Define Status\":\"Status Definition\",\"Max size is %d character.\":\"You can only enter a maximum of %d characters.\",\"Save bug fields setting successfully!\":\"Field settings saved successfully.\",\"step name can not repeat\":\"Duplicate status names are not allowed.\",\"Save bugtrace fields setting successfully!\":\"Bug display fields saved successfully.\",\"SaveAndSync\":\"Save & Sync to All Statuses\",\"Cannot move or copy between single workflow and multi workflow workspaces\":\"Unable to copy or move between single-workflow and multi-workflow projects.\",\"The original name is the unique identifier for the status.\":\"The original name of a status is the unique identifier of the status.\",\"step status name cannot exceed %d characters!\":\"Status name cannot exceed %d characters.\",\"The max size is 100 character.\":\"Status description cannot exceed 100 characters.\",\"step alias name cannot exceed %d characters!\":\"Status alias cannot exceed %d characters.\",\"The alias will be display on the page, and max size is %d character.\":\"Status name is the name displayed on the page. A maximum of %d characters are allowed.\",\"The max size is 512 character.\":\"You can only enter a maximum of 512 characters.\",\"story\":\"#Story# Workflow\",\"Save\":\"Save\",\"bugtrace\":\"Bug Workflow\",\"Workflow doesn't exists.\":\"Workflow does not exist.\",\"No\":\"No\",\"Bug Workflow Status List\":\"Bug Workflow Status List\",\"Status Pool Sort\":\"Status Pool Sorting Order\",\"Cannot delete the workflow in use\":\"Unable to delete this workflow as it is being used by %d #story# categories.\",\"The workflow not exist\":\"The workflow does not exist.\",\"Yes\":\"Yes\",\"first step is same with last step\":\"Initial status and final status must be different.\",\"There are <a class=\\\"j-to-worktable-search\\\"><\\/a> story(s) in this status, please choose another status.\":\"There are <a class=\\\"j-to-worktable-search\\\"><\\/a> #story#(s) in this status, please choose another status.\",\"Cannot delete the workflow in use #num#\":\"Unable to delete this workflow as it is being used by #num# #story# categories.\",\"Add node in the \\u300c#statusName#\\u300d status\":\"Add step in the \\u300c#statusName#\\u300d status\",\"After enabling, you can schedule nodes by associating time fields.\":\"After enabling, you can use the time field of the #story# to schedule nodes.\",\"#count# nodes in progress\":\"#count# steps in progress\",\"Node name exceeds #count# characters\":\"Step name exceeds #count# characters\",\"Node effort: #effort#, remaining: #remain#\":\"Step effort: #effort#, remaining: #remain#\",\"Confirm to set [#name#] to the current status?\":\"Confirm to set [#name#] to the current status?\",\"Due to workflow configuration reasons, it is not possible to directly update to [#name1#], the status will be changed to [#name2#].\":\"Due to workflow configuration reasons, it is not possible to directly update to [#name1#], the status will be changed to [#name2#].\",\"and so on, a total of #count# condition branches and executions.\":\"and so on, a total of #count# condition branches and executions.\",\"#type# Change #field# to #value#\":\"#type# Change #field# to #value#\",\"The current #story# has been ended\":\"The current #story# has been ended\",\"The operation of [#operationName#] is being executed. Once ended, if restart, the process will start over.\":\"The operation of [#operationName#] is being executed. Once ended, if restart, the process will start over.\",\"Break down the various stages of a work item lifecycle into specific activity nodes, set the execution order and dependency relationships between nodes, and progress the process by completing nodes.\":\"Break down the various stages of a workitem lifecycle into specific activity steps, set the execution order and dependency relationships between steps, and progress the process by completing steps.\",\"Set post-node\":\"Set post-step\",\"Add post-node\":\"Add post-step\",\"The status includes nodes, please handle the nodes first.\":\"The status includes steps, please handle the steps first.\",\"The administrator has changed the workflow, please reselect the current node\":\"The administrator has changed the workflow, please reselect the current step\",\"Supporting multiple process nodes to proceed simultaneously, with multiple lines of parallel process advancement.\":\"Supporting multiple process steps to proceed simultaneously, with multiple lines of parallel process advancement.\",\"Enable Node Schedule\":\"Enable Step Schedule\",\"The skip conditions have been met, the node has been automatically skipped.\":\"The skip conditions have been met, the step has been automatically skipped.\",\"Node attribute\":\"Step Attribute\",\"Node Schedule\":\"Step Schedule\",\"Node Schedule Disabled\":\"Step Schedule Disabled\",\"Node display configuration\":\"Step display configuration\",\"Only the checked nodes will be displayed at the top\":\"Only the checked steps will be displayed at the top\",\"Set the operation buttons for the node\":\"Set the operation buttons for the step\",\"After clicking, the current node will be completed and subsequent nodes will continue to be executed\":\"After clicking, the current step will be completed and subsequent steps will continue to be executed\",\"After clicking, return to the specified node without submitting the modification of the field value\":\"After clicking, return to the specified step without submitting the modification of the field value\",\"Workflow node has expired\":\"Workflow step has expired\",\"Mark as In-Progress Node\":\"Mark as In-Progress Step\",\"After setting to the current status, the nodes in progress are:\":\"After setting to the current status, the steps in progress are:\",\"Only users who meet the following conditions have node operation permission\":\"Only users who meet the following conditions have step operation permission\",\"Only when the triggering or execution of an automated event includes the current node, the corresponding event will be displayed in this panel.\":\"Only when the triggering or execution of an automated event includes the current step, the corresponding event will be displayed in this panel.\",\"Invalid Node\":\"Invalid Step\",\"After setting to the current status, no node in progress.\":\"After setting to the current status, no step in progress.\",\"Automatically skip this node when conditions are met\":\"Automatically skip this step when conditions are met\",\"The operation of [Suspend] is being executed. After suspension, the operation of this workflow node will be paused.\":\"The operation of [Suspend] is being executed. After suspension, the operation of this workflow step will be paused.\",\"Node scheduling is not enabled for this node. Please go to the basic settings to enable it.\":\"Step scheduling is not enabled for this step. Please go to the basic settings to enable it.\",\"The current rules will be unrelated to the node \\u300c#nodeName#\\u300d after saving. Do you wish to continue saving?\":\"The current rules will be unrelated to the step #stepName# after saving. Do you wish to continue saving?\",\"After modification, the nodes in progress are:\":\"After modification, the steps in progress are:\",\"Node Automation Events\":\"Step Automation Events\",\"node\":\"step\",\"Confirm to set [#name#] to the In-Progress Node?\":\"Confirm to set [#name#] to the In-Progress Step?\"},\"workflow bug\":{\"reopened\":\"Reopen\",\"resolved\":\"Resolved\",\"new\":\"New\",\"postponed\":\"Postponed\",\"unconfirmed\":\"Pending Confirmation\",\"closed\":\"Closed\",\"assigned\":\"Assigned\",\"PMM audited\":\"Review by PMM\",\"acknowledged\":\"Understood\",\"in progress\":\"Accept\\/Handle\",\"feedback\":\"Need Further Instructions\",\"TM audited\":\"Review by TM\",\"QA audited\":\"Review by QA\",\"suspended\":\"Suspended\",\"verified\":\"Verified\",\"rejected\":\"Rejected\",\"PM audited\":\"Review by PM\",\"planning\":\"Under Plan\"},\"workflow story\":{\"suspended\":\"Suspended\",\"resolved\":\"Fulfilled\",\"new\":\"New\",\"planned\":\"Planned\",\"audited\":\"Reviewed\",\"product experience\":\"Product Experience\",\"status 3\":\"Other Status 3\",\"testing\":\"Under Test\",\"planning\":\"Planning\",\"developing\":\"Under Development\",\"status 14\":\"Other Status 14\",\"status 13\":\"Other Status 13\",\"UI reconstruct\":\"Page Rebuild\",\"auditing\":\"Under Review\",\"in progress\":\"Fulfilling\",\"status 7\":\"Other Status 7\",\"rejected\":\"Rejected\",\"status 10\":\"Other Status 10\",\"for test\":\"Transfer To Test\",\"status 6\":\"Other Status 6\",\"status 2\":\"Other Status 2\",\"UI design\":\"UI Design\",\"abandoned\":\"Cancel Temporarily\",\"status 5\":\"Other Status 5\",\"status 8\":\"Other Status 8\",\"status 12\":\"Other Status 12\",\"status 15\":\"Other Status 15\",\"status 9\":\"Other Status 9\",\"status 4\":\"Other Status 4\",\"status 1\":\"Other Status 1\",\"status 11\":\"Other Status 11\"},\"workflows change\":{\"Change status %s's name alias from \\\"%s\\\" to \\\"%s\\\".\":\"Change the alias of \\\"%s\\\" from \\\"%s\\\" to \\\"%s\\\".\",\"Change %s from \\\"%s\\\" to \\\"%s\\\".\":\"Change \\\"%s\\\" from \\\"%s\\\" to \\\"%s\\\".\",\"Change end status\":\"Edit Final Status\",\"Add Status \\\"%s\\\".\"