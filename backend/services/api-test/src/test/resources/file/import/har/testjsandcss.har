            "mimeType": "application/javascript",
            "compression": 2930,
            "text": "var keepUrlParamsInit, keepUrlParamsStorage, isIframeEnv, keepUrlParamsInFrameGetQueryVariable, checkPageHiddenParams, setToLocalStorage;\n\nkeepUrlParamsStorage = {\n    set: function (key, value, expireSecond = 5) {\n        const obj = {\n            value,\n            time: Date.now(),\n            expire: expireSecond * 1000,\n        };\n        localStorage.setItem(key, JSON.stringify(obj));\n    },\n    get: function (key) {\n        const item = localStorage.getItem(key);\n        if (item) {\n            const obj = JSON.parse(item);\n            if (Date.now() < (obj.time + obj.expire)) {\n                return obj.value;\n            }\n            localStorage.removeItem(key);\n        }\n        return null;\n    },\n};\n\n\nisIframeEnv = function () {\n    return window.self !== window.parent;\n}\n\n\n// 参数精确获取\n\nkeepUrlParamsInFrameGetQueryVariable = function (variable) {\n    let query = window.location.search.substring(1).split('#')[0];\n    let vars = query.split(\"&\");\n    for (let i = 0; i < vars.length; i++) {\n        let pair = vars[i].split(\"=\");\n        if (variable === pair[0]) {\n            return pair[1];\n        }\n    };\n    return '';\n}\n\n\n\n\n// 检查隐藏顶部导航侧边栏的参数\ncheckPageHiddenParams = function () {\n    if (!isIframeEnv()) {\n        return;\n    }\n    const hiddenTopSideCache = keepUrlParamsStorage.get('hiddenTopSide');\n    const hiddenLeftSideCache = keepUrlParamsStorage.get('hiddenLeftSide');\n    const tapdIframeFromCache = keepUrlParamsStorage.get('tapdIframeFrom');\n    const parentPathCache = keepUrlParamsStorage.get('parent_path')\n    const hiddenTopSide = keepUrlParamsInFrameGetQueryVariable('hidden_top_side');\n    const hiddenLeftSide = keepUrlParamsInFrameGetQueryVariable('hidden_left_side');\n    const tapdIframeFrom = keepUrlParamsInFrameGetQueryVariable('tapd_iframe_from');\n    const parentPath = keepUrlParamsInFrameGetQueryVariable('parent_path');\n    let newSearch = '';\n    if ('1' == hiddenTopSideCache && 'true' !== hiddenTopSide) {\n        newSearch = '&hidden_top_side=true';\n    }\n    if ('1' == hiddenLeftSideCache && 'true' !== hiddenLeftSide) {\n        newSearch = newSearch + '&hidden_left_side=true';\n    }\n    if ('1' == tapdIframeFromCache && !tapdIframeFrom) {\n        newSearch = newSearch + '&tapd_iframe_from=' + tapdIframeFromCache;\n    }\n    if (parentPathCache && !parentPath) {\n        newSearch = newSearch + '&parent_path=' + parentPathCache;\n    }\n    if (newSearch) {\n        if (window.location.search.indexOf('?') < 0) {\n            newSearch = newSearch.replace('&', '?');\n        }\n        window.location.search = window.location.search + newSearch;\n    }\n}\n\n\n\n\n\n\n// 记忆隐藏顶部导航侧边栏参数\nsetToLocalStorage = function () {\n    if (!isIframeEnv()) {\n        return;\n    }\n    const hiddenTopSide = keepUrlParamsInFrameGetQueryVariable('hidden_top_side');\n    if ('true' == hiddenTopSide) {\n        keepUrlParamsStorage.set('hiddenTopSide', '1');\n    }\n    const hiddenLeftSide = keepUrlParamsInFrameGetQueryVariable('hidden_left_side');\n\n    if ('true' == hiddenLeftSide) {\n        keepUrlParamsStorage.set('hiddenLeftSide', '1');\n    }\n\n    const tapdIframeFrom = keepUrlParamsInFrameGetQueryVariable('tapd_iframe_from');\n    if (tapdIframeFrom) {\n        keepUrlParamsStorage.set('tapdIframeFrom', '1');\n    }\n\n    const parentPath = keepUrlParamsInFrameGetQueryVariable('parent_path');\n    if (parentPath) {\n        keepUrlParamsStorage.set('parentPath', parentPath);\n    }\n}\n\n\n\nkeepUrlParamsInit = function () {\n    try {\n        checkPageHiddenParams();\n        // 页面隐藏时，保存参数到本地存储\n        window.removeEventListener('beforeunload', setToLocalStorage);\n        window.addEventListener('beforeunload', setToLocalStorage);\n    } catch (error) {\n        console.error(error);\n    }\n}\n\n\n\nwindow.removeEventListener('DOMContentLoaded', () => {\n    if (isIframeEnv()) {\n        keepUrlParamsInit();\n    }\n})\n\nwindow.addEventListener('DOMContentLoaded', () => {\n    if (isIframeEnv()) {\n        keepUrlParamsInit();\n    }\n})"
