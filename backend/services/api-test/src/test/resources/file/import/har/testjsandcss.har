            "compression": 4365,
            "text": ".entity-detail-checklist{clear:both;margin-bottom:36px}.entity-detail-checklist__top-left{display:-ms-flexbox;display:flex}.entity-detail-checklist__top__add button{vertical-align:top}.entity-detail-checklist .tapd-table__body-empty-content{display:none}.entity-detail-checklist .tapd-light-table{width:calc(100% - 32px);display:none}.entity-detail-checklist .tapd-light-table .agi-virtual-scroll__wrap{overflow-x:hidden}.entity-detail-checklist .tapd-light-table .agi-virtual-scroll__wrap:hover{overflow:auto}.entity-detail-checklist .tapd-light-table.el-loading-parent--relative{min-height:120px}.entity-detail-checklist .tapd-light-table thead th:not([widget=drag]){border-top:1px solid #e8e9ec}.entity-detail-checklist .tapd-light-table .tapd-table__head--adjustable .row-head-cell__content:hover{color:#989fae}.entity-detail-checklist .tapd-light-table .tapd-loading{margin-left:32px}.entity-detail-checklist .check-list__header__right{display:none}.entity-detail-checklist.expand .check-list__header__right,.entity-detail-checklist.expand .tapd-light-table{display:block}.entity-detail-checklist .check-list__header{position:sticky;top:0;background:#fff;z-index:10}.entity-detail-checklist.dragging .tapd-light-table{z-index:11}.entity-detail-checklist__top__expand-area{-webkit-user-select:none;-ms-user-select:none;user-select:none;margin-left:4px;border-radius:4px}.entity-detail-checklist__top__expand-area .title{font-size:14px;display:inline-block;padding-right:10px;margin-right:0;font-weight:600;float:none}.entity-detail-checklist__top__expand-area .entity-detail-checklist__top__expand{font-size:16px;line-height:28px;margin:0 6px;vertical-align:top;color:currentColor}.entity-detail-checklist__top__expand-area .entity-detail-checklist__top__expand:hover{color:currentColor}.entity-detail-checklist__top__expand-area:hover{background-color:rgba(21,38,70,.06);cursor:pointer}.checklist-edit-dialog.el-dialog{width:1000px;min-height:650px;overflow:hidden}.checklist-edit-dialog.el-dialog .el-dialog__body{position:relative;padding:0!important}.checklist-edit-dialog.el-dialog .el-dialog__body .check-list__header{margin-top:11px;margin-bottom:11px;padding:2px 0}.checklist-edit-dialog.el-dialog .el-dialog__body .entity-detail-checklist__top__expand-area{pointer-events:none}.checklist-edit-dialog.el-dialog .el-dialog__body .entity-detail-checklist__top__expand{visibility:hidden}.checklist-edit-dialog.el-dialog .checklist-dialog-empty-content{position:absolute;top:240px;left:50%;-webkit-transform:translateX(-50%);transform:translateX(-50%);text-align:center}.checklist-edit-dialog.el-dialog .checklist-dialog-empty-content .empty-content__icon{background-image:url(data:image/png;base64,);background-repeat:no-repeat;width:150px;height:150px;margin:auto;display:block;background-size:150px 150px}.checklist-edit-dialog.el-dialog .checklist-dialog-empty-content .empty-content__tips{text-align:center}.checklist-edit-dialog.el-dialog .checklist-dialog-empty-content .empty-content__tips span{color:#8c95a8;font-size:14px}.checklist-edit-dialog.el-dialog .checklist-dialog-empty-content .empty-content__slot{margin-top:12px}"
          },
